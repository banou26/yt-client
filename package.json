{
  "name": "@banou/yt-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:frame && npm run generate && vp build",
    "build:frame": "vp build -c vite.frame.config.ts",
    "dev": "npm run build:frame && npm run generate && vp dev --port 4561",
    "generate": "graphql-codegen --config codegen.ts",
    "lint": "vp lint src",
    "postinstall": "patch-package",
    "test": "vp test run src",
    "test:browser": "playwright test",
    "type-check": "npm run generate && tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@fkn/lib": "^0.9.5",
    "@mercuryworkshop/proxy-transports": "1.0.2",
    "@mercuryworkshop/scramjet": "https://github.com/Banou26/scramjet/releases/download/2.0.67-alpha.2-7b21431/scramjet-2.0.67-alpha.2-7b21431.tgz",
    "@mercuryworkshop/scramjet-controller": "0.0.14",
    "@urql/exchange-graphcache": "^9.0.1",
    "bgutils-js": "3.2.0",
    "googlevideo": "4.0.4",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.15.1",
    "libcurl.js": "0.7.4",
    "lucide-react": "^1.24.0",
    "osra": "^0.6.3",
    "preact": "11.0.0-beta.0",
    "shaka-player": "4.16.37",
    "urql": "^5.0.1",
    "wouter": "^3.7.1",
    "youtubei.js": "17.0.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-resolvers": "^4.5.1",
    "@playwright/test": "^1.54.2",
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^24.0.0",
    "patch-package": "^8.0.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plus": "0.3.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vitest": "4.1.11"
  }
}
